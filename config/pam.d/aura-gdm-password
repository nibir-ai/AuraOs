# PAM configuration for GDM graphical logins with Google OAuth integration
# Placed at /etc/pam.d/aura-gdm-password

auth    requisite     pam_nologin.so
auth    required      pam_google.so account_db=/var/lib/auraos/accounts
auth    optional      pam_gnome_keyring.so
auth    required      pam_unix.so nullok_secure try_first_pass
auth    optional      pam_permit.so

account required      pam_unix.so
account required      pam_permit.so

password required     pam_unix.so obscure sha512

session required      pam_limits.so
session required      pam_unix.so
session required      pam_google.so refresh_tokens
session optional      pam_gnome_keyring.so auto_start
session required      pam_systemd.so
